{%- comment -%}
  Giulia Beauty — Histoire & engagements (dark luxe). Image à gauche, texte +
  blocs "engagement" à droite. Blocs répétables.
{%- endcomment -%}

{%- assign s = section.settings -%}

<style>
  #st-{{ section.id }}{--bg:{{ s.color_bg }};--gold:{{ s.color_gold }};--amber:{{ s.color_amber }};--cream:{{ s.color_cream }};--muted:{{ s.color_muted }};--line:{{ s.color_gold }}2e;
    background:var(--bg);color:var(--cream);padding:clamp(4.5rem,9vw,8rem) 0;font-family:'Jost',var(--font-body-family,sans-serif)}
  #st-{{ section.id }} .swrap{max-width:1240px;margin:0 auto;padding:0 clamp(1.3rem,4vw,3rem)}
  #st-{{ section.id }} .sgrid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}
  #st-{{ section.id }} .svis{position:relative;aspect-ratio:4/5;border-radius:4px;overflow:hidden;background:radial-gradient(circle at 60% 40%,var(--amber),#3A2410 70%)}
  #st-{{ section.id }} .svis img{width:100%;height:100%;object-fit:cover}
  #st-{{ section.id }} .eyebrow{font-size:.72rem;letter-spacing:.38em;text-transform:uppercase;color:var(--gold)}
  #st-{{ section.id }} h2{font-family:'Cormorant Garamond',var(--font-heading-family,serif);font-weight:500;font-size:clamp(2rem,4.2vw,3.2rem);margin:.6rem 0 1.1rem;line-height:1.05}
  #st-{{ section.id }} .sbody{color:var(--muted);margin-bottom:1.5rem;font-weight:300}
  #st-{{ section.id }} .frow{display:flex;gap:1rem;margin-bottom:1.1rem;align-items:flex-start}
  #st-{{ section.id }} .frow .ic{flex:none;width:46px;height:46px;border:1px solid var(--line);display:grid;place-items:center;color:var(--gold);font-size:1.15rem}
  #st-{{ section.id }} .frow strong{font-family:'Cormorant Garamond',serif;font-size:1.2rem;display:block}
  #st-{{ section.id }} .frow small{color:var(--muted)}
  #st-{{ section.id }} .sbtn{display:inline-flex;margin-top:1rem;padding:1rem 2.1rem;font-size:.74rem;letter-spacing:.2em;text-transform:uppercase;font-weight:500;background:linear-gradient(135deg,var(--gold),var(--amber));color:#2A1A08;transition:transform .3s,box-shadow .3s}
  #st-{{ section.id }} .sbtn:hover{transform:translateY(-3px);box-shadow:0 16px 40px {{ s.color_amber }}59}
  #st-{{ section.id }} .rv{opacity:0;transform:translateY(24px)}
  @media(max-width:900px){#st-{{ section.id }} .sgrid{grid-template-columns:1fr}#st-{{ section.id }} .svis{order:-1;max-width:460px;margin-inline:auto}}
  @media(prefers-reduced-motion:reduce){#st-{{ section.id }} .rv{opacity:1;transform:none}}
</style>

<section id="st-{{ section.id }}">
  <div class="swrap">
    <div class="sgrid">
      <div class="svis rv">{%- if s.image -%}<img src="{{ s.image | image_url: width: 900 }}" alt="{{ s.image.alt | escape }}" width="{{ s.image.width }}" height="{{ s.image.height }}" loading="lazy">{%- endif -%}</div>
      <div>
        {%- if s.eyebrow != blank -%}<div class="eyebrow rv">{{ s.eyebrow }}</div>{%- endif -%}
        {%- if s.title != blank -%}<h2 class="rv">{{ s.title }}</h2>{%- endif -%}
        {%- if s.body != blank -%}<div class="sbody rv">{{ s.body }}</div>{%- endif -%}

        {%- for block in section.blocks -%}
          <div class="frow rv" {{ block.shopify_attributes }}>
            <div class="ic">{{ block.settings.icon | default: '✦' }}</div>
            <div><strong>{{ block.settings.heading }}</strong><small>{{ block.settings.text }}</small></div>
          </div>
        {%- endfor -%}

        {%- if s.btn_label != blank -%}<a class="sbtn rv" href="{{ s.btn_link | default: '#' }}">{{ s.btn_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
(function(){var root=document.getElementById('st-{{ section.id }}');
  function go(){if(window.gsap&&window.ScrollTrigger){gsap.registerPlugin(ScrollTrigger);
    if(!matchMedia('(prefers-reduced-motion: reduce)').matches){gsap.to(root.querySelectorAll('.rv'),{opacity:1,y:0,duration:.6,stagger:.08,ease:'power2.out',scrollTrigger:{trigger:root,start:'top 80%'}});}
    else root.querySelectorAll('.rv').forEach(function(e){e.style.opacity=1;e.style.transform='none';});}
    else root.querySelectorAll('.rv').forEach(function(e){e.style.opacity=1;e.style.transform='none';});}
  if(window.gsap)go();else{addEventListener('load',go);setTimeout(go,1200);}})();
</script>

{% schema %}
{
  "name": "Histoire dark luxe",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre histoire" },
    { "type": "text", "id": "title", "label": "Titre", "default": "La beauté, en toute conscience" },
    { "type": "richtext", "id": "body", "label": "Texte", "default": "<p>Giulia Beauty réunit la technologie et le soin : des rituels beauté pensés pour sublimer votre peau au quotidien, avec élégance.</p>" },
    { "type": "text", "id": "btn_label", "label": "Bouton — texte", "default": "Explorer nos soins" },
    { "type": "url", "id": "btn_link", "label": "Bouton — lien" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "color_bg", "label": "Fond", "default": "#1A1209" },
    { "type": "color", "id": "color_gold", "label": "Or", "default": "#E8C07D" },
    { "type": "color", "id": "color_amber", "label": "Ambre", "default": "#C98A3B" },
    { "type": "color", "id": "color_cream", "label": "Texte clair", "default": "#F3E7D3" },
    { "type": "color", "id": "color_muted", "label": "Texte secondaire", "default": "#B59B78" }
  ],
  "blocks": [
    { "type": "feature", "name": "Engagement", "settings": [
      { "type": "text", "id": "icon", "label": "Icône (emoji/caractère)", "default": "✦" },
      { "type": "text", "id": "heading", "label": "Titre", "default": "Formules clean" },
      { "type": "text", "id": "text", "label": "Texte", "default": "Sans parabènes, silicones ni sulfates." }
    ]}
  ],
  "presets": [ { "name": "Histoire dark luxe", "blocks": [ { "type": "feature" }, { "type": "feature" }, { "type": "feature" } ] } ]
}
{% endschema %}
